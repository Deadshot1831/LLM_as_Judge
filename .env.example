ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://judge:judge@localhost:5433/judge

# The judge, and the application it judges. Keep them different families by default —
# self-preference is measured explicitly rather than built into every number in the repo.
JUDGE_MODEL=claude-opus-5
ANSWERER_MODEL=claude-sonnet-5

# Competing answer families, used for pairwise verdicts and the self-preference swap.
GENERATOR_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001

# Optional. Set both and every run records what it cost, so "can we afford this gate on
# every pull request" is answerable. Left unset, runs record token counts only — a price
# hardcoded in source goes stale silently.
# JUDGE_PRICE_IN_PER_MTOK=15
# JUDGE_PRICE_OUT_PER_MTOK=75
